# Frontend (Next.js) configuration template.
#
#   Local development:  cp frontend/.env.example frontend/.env.local
#   Production build:   cp frontend/.env.example frontend/.env.production
#                       (or set the variables in your host's build environment)
#
# NEXT_PUBLIC_* values are inlined into the JavaScript bundle at build time and
# are visible to anyone using the site. Never put a secret here.

# ---------------------------------------------------------------------------
# API location
# ---------------------------------------------------------------------------
# Base URL of the Django API, including the /api suffix and no trailing slash.
# It must be an origin listed in the backend's CORS_ALLOWED_ORIGINS counterpart
# (i.e. the backend must allow this app's origin back).
# Production: https://api.example.com/api
NEXT_PUBLIC_API_URL=http://localhost:8000/api
