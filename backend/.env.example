# Backend (Django) configuration template — copy to `backend/.env` and fill in
# real values. `.env` files are gitignored; this example is the only one committed.
#
#   cp backend/.env.example backend/.env
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
#
# On a managed host (Render, Fly, Heroku, …) set these as environment variables
# instead of shipping a file — real environment variables always win over `.env`.

# ---------------------------------------------------------------------------
# Core Django
# ---------------------------------------------------------------------------
# Generate a unique key per environment. Django refuses to boot with the
# insecure fallback when DJANGO_DEBUG=false.
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
# Production: your real API hostnames, e.g. api.example.com
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# ---------------------------------------------------------------------------
# Browser origins allowed to call the API with cookies
# ---------------------------------------------------------------------------
# Must include the scheme, and match where the frontend is served from.
# Production: https://app.example.com
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Set true when the frontend and API are on different sites in production, so
# cookies become SameSite=None; Secure. Requires HTTPS on both ends.
CROSS_SITE_COOKIES=false

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Managed Postgres connection URL. Leave unset in development to fall back to a
# local SQLite file; it is REQUIRED when DJANGO_DEBUG=false.
#
# Supabase: Project Settings > Database > Connection string. Prefer the
# "Connection pooling" (Session mode, port 5432) URI, whose user is
# postgres.<project-ref> — the direct db.<project-ref>.supabase.co host is
# IPv6-only and unreachable from IPv4-only networks and hosts.
#
#   postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
#
# URL-encode any of : / ? # [ ] @ that appear in the password.
DATABASE_URL=

# Seconds to keep a connection open for reuse. Use 0 when running behind a
# transaction-mode pooler (port 6543) or on serverless hosts.
DB_CONN_MAX_AGE=600
# Appends sslmode=require. Keep true for any hosted database.
DB_SSL_REQUIRE=true

# ---------------------------------------------------------------------------
# Proxy / TLS — set both to true in production behind an HTTPS proxy
# ---------------------------------------------------------------------------
# Lets Django detect HTTPS via X-Forwarded-Proto (Render, Fly, Heroku, nginx).
TRUST_PROXY_SSL_HEADER=false
# Redirect http:// to https://. Defaults to true when DJANGO_DEBUG=false.
SECURE_SSL_REDIRECT=false
# HSTS max-age in seconds; applied only when DJANGO_DEBUG=false.
SECURE_HSTS_SECONDS=31536000

# ---------------------------------------------------------------------------
# One-time migration label
# ---------------------------------------------------------------------------
# Name given to the profile that inherits pre-multi-user attendance records.
# Only read once, by migration 0006. Migration 0007 then gives that profile a
# login account with the same name, locked until you run:
#   python manage.py changepassword <username>
ATTENDANCE_DEFAULT_EMPLOYEE=Hanz
