# Backend local development configuration. Gitignored — never commit it.
# Production values are documented in backend/.env.example and the README.

# ---------------------------------------------------------------------------
# Core Django
# ---------------------------------------------------------------------------
DJANGO_SECRET_KEY=vkq-)q@h5%x8!=+_(_z^dyyhhxw=*^p@ycq+pe7s#trky_^ur&
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# ---------------------------------------------------------------------------
# Browser origins allowed to call the API with cookies
# ---------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# localhost:3000 -> localhost:8000 is same-site, so SameSite=Lax works in dev.
# Set true only when the frontend and API are on different domains in production.
CROSS_SITE_COOKIES=false

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Supabase Postgres. Leave unset to fall back to the local SQLite file.
# Grab the exact string from Supabase > Project Settings > Database > Connection
# string. Prefer the "Connection pooling" (Session mode, port 5432) URI — the
# direct db.<ref>.supabase.co host is IPv6-only and unreachable from IPv4-only
# networks and hosts.
DATABASE_URL=postgresql://postgres:8u44A30Xwo2pRx37@db.unirqjtsezyuixoxwgmb.supabase.co:5432/postgres

# ---------------------------------------------------------------------------
# Proxy / TLS
# ---------------------------------------------------------------------------
# Intentionally unset here. These are only read when DJANGO_DEBUG=false, and
# leaving them out means production gets the safe defaults (SSL redirect + HSTS
# on) rather than inheriting a dev "false". See backend/.env.example before deploying.

# ---------------------------------------------------------------------------
# One-time migration label
# ---------------------------------------------------------------------------
# Name given to the profile that inherited the pre-multi-user records.
# Only read by migration 0006, which has already run. Kept for reproducibility.
ATTENDANCE_DEFAULT_EMPLOYEE=Hanz
